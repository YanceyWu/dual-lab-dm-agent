# Local runtime
DATABASE_PATH=data/pm.db
LOG_LEVEL=INFO

# JIRA: set locally for runtime connector validation and sync
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_VERIFY_SSL=true

# Confluence: may reuse JIRA/Atlassian authentication when left empty
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_CLOUD_ID=
CONFLUENCE_ACTION_TRACKER_PAGE_ID=
CONFLUENCE_VERIFY_SSL=true

# Optional Atlassian OAuth
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REFRESH_TOKEN=
ATLASSIAN_CLOUD_ID=

# Optional browser-assisted ServiceNow import
SNOW_BASE_URL=
SNOW_REPORT_ID=
SNOW_BROWSER=edge
SNOW_BROWSER_PROFILE=

# JSON list of alias groups; values remain local to each DM installation.
# Example: [["Project Atlas", "Atlas Delivery"]]
PROJECT_ALIAS_GROUPS_JSON=[]
